---
import Layout from "@/layouts/Layout.astro";

if (Astro.locals.user) {
  return Astro.redirect("/dashboard");
}
---

<Layout title="Trail Route Estimator - Sign in to continue">
  <main class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <section
      class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Trail Route Estimator
      </h1>
      <p class="mb-6 text-sm text-blue-100/80 sm:text-base">
        Sign in to upload your GPX route, compute a personalized estimate, and track your estimation history.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href="/auth/signin"
          class="inline-flex h-10 items-center justify-center rounded-lg bg-purple-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-purple-500"
        >
          Sign in
        </a>
        <a
          href="/auth/signup"
          class="inline-flex h-10 items-center justify-center rounded-lg border border-white/30 bg-white/10 px-5 text-sm font-semibold text-white transition-colors hover:bg-white/20"
        >
          Create account
        </a>
      </div>
    </section>
  </main>
</Layout>
