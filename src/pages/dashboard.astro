---
import RouteEstimationCard from "@/components/routes/RouteEstimationCard";
import RouteMiniMap from "@/components/routes/RouteMiniMap";
import RouteUploadForm from "@/components/routes/RouteUploadForm";
import SavedEstimationHistory from "@/components/routes/SavedEstimationHistory.astro";
import { buildSavedEstimationHistoryItems, resolveSavedHistoryWarning } from "@/lib/estimation/history-view";
import Layout from "@/layouts/Layout.astro";
import { getRouteEstimationForUser, listRouteEstimationHistoryForUser } from "@/lib/estimation/service";
import { getRouteSnapshotForUser, listSavedRouteHistoryForUser } from "@/lib/route/service";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
const warning = Astro.url.searchParams.get("warning");

const supabase = createClient(Astro.request.headers, Astro.cookies);
const [snapshotResult, estimationResult, estimationHistoryResult, routeHistoryResult] =
  user && supabase
    ? await Promise.all([
        getRouteSnapshotForUser(supabase, user.id),
        getRouteEstimationForUser(supabase, user.id),
        listRouteEstimationHistoryForUser(supabase, user.id),
        listSavedRouteHistoryForUser(supabase, user.id),
      ])
    : [{ data: null }, { data: null }, { data: [] }, { data: [] }];
const snapshot = snapshotResult.data;
const estimation = estimationResult.data;
const estimationWarning = estimationResult.error
  ? "We could not load your latest personalized estimation right now."
  : null;
const historyWarning = resolveSavedHistoryWarning(warning, estimationHistoryResult.error, routeHistoryResult.error);
const savedHistoryItems = buildSavedEstimationHistoryItems(estimationHistoryResult.data, routeHistoryResult.data);
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div
      class="mx-auto w-full max-w-4xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="mb-6 text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      {
        estimationWarning ? (
          <p class="mb-4 rounded-lg border border-amber-500/30 bg-amber-900/30 px-3 py-2 text-sm text-amber-200">
            {estimationWarning}
          </p>
        ) : null
      }
      {
        historyWarning ? (
          <p class="mb-4 rounded-lg border border-amber-500/30 bg-amber-900/30 px-3 py-2 text-sm text-amber-200">
            {historyWarning}
          </p>
        ) : null
      }

      <div class="grid gap-6 md:grid-cols-2">
        <div class="space-y-4 rounded-xl border border-white/10 bg-white/5 p-4">
          <h2 class="text-lg font-semibold text-white">Upload GPX</h2>
          <RouteUploadForm serverError={error} serverSuccess={success} hasSnapshot={Boolean(snapshot)} client:load />
          <a
            href="/profile"
            class="inline-block text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
          >
            Edit profile
          </a>
        </div>

        <div class="space-y-4 rounded-xl border border-white/10 bg-white/5 p-4">
          <h2 class="text-lg font-semibold text-white">Latest route context</h2>
          {
            snapshot ? (
              <>
                <div class="grid grid-cols-2 gap-2 text-sm text-blue-100/75">
                  <p>
                    <span class="text-blue-100/55">Points:</span> {snapshot.pointCount}
                  </p>
                  <p>
                    <span class="text-blue-100/55">Distance:</span> {(snapshot.totalDistanceM / 1000).toFixed(2)} km
                  </p>
                  <p>
                    <span class="text-blue-100/55">Elevation gain:</span>{" "}
                    {snapshot.elevationGainM !== null ? `${snapshot.elevationGainM.toFixed(0)} m` : "n/a"}
                  </p>
                  <p>
                    <span class="text-blue-100/55">Elevation loss:</span>{" "}
                    {snapshot.elevationLossM !== null ? `${snapshot.elevationLossM.toFixed(0)} m` : "n/a"}
                  </p>
                </div>
                <RouteMiniMap geometry={snapshot.geometry} bounds={snapshot.bounds} />
              </>
            ) : (
              <p class="text-sm text-blue-100/70">
                No route uploaded yet. Add a GPX file to see route context and map preview.
              </p>
            )
          }
        </div>
      </div>

      <div class="mt-6">
        {
          estimation ? (
            <RouteEstimationCard estimation={estimation} client:load />
          ) : (
            <p class="rounded-xl border border-white/10 bg-white/5 p-4 text-sm text-blue-100/70">
              Personalized estimation is not available yet. Upload a route and keep your profile completed to generate
              the latest result.
            </p>
          )
        }
      </div>

      <div class="mt-6">
        <SavedEstimationHistory items={savedHistoryItems} />
      </div>
    </div>
  </div>
</Layout>
