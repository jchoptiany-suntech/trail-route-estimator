---
import type { SavedEstimationHistoryItem } from "@/lib/estimation/history-view";

interface Props {
  items: SavedEstimationHistoryItem[];
  protectedHistoryEntryId?: number | null;
}

const { items, protectedHistoryEntryId = null } = Astro.props;

function formatEstimatedTime(minutes: number): string {
  const roundedMinutes = Math.max(0, Math.round(minutes));
  const hours = Math.floor(roundedMinutes / 60);
  const remainingMinutes = roundedMinutes % 60;

  if (hours === 0) {
    return `${roundedMinutes} min`;
  }
  if (remainingMinutes === 0) {
    return `${hours} h`;
  }

  return `${hours} h ${remainingMinutes} min`;
}

function formatDifficultyLabel(label: string): string {
  return label.charAt(0).toUpperCase() + label.slice(1);
}

function formatComputedAt(iso: string): string {
  return new Date(iso).toLocaleString("en-US", {
    hour12: false,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function formatPace(minutesPerKm: number | null): string {
  if (minutesPerKm === null || !Number.isFinite(minutesPerKm) || minutesPerKm <= 0) {
    return "n/a";
  }

  const totalSeconds = Math.round(minutesPerKm * 60);
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return `${minutes}:${seconds.toString().padStart(2, "0")} min/km`;
}

function formatItraIndexInclusion(status: string | null): string {
  return status === "available" ? "included" : "not included";
}

function formatWeatherForecastInclusion(status: string | null): string {
  return status === "available" ? "included" : "not included";
}
---

<div class="rounded-xl border border-white/10 bg-white/5 p-4">
  <h2 class="mb-3 text-lg font-semibold text-white">Saved estimation history</h2>
  {
    items.length > 0 ? (
      <ul class="space-y-3">
        {items.map((item) => (
          <li class="relative rounded-lg border border-white/10 bg-white/5 p-3">
            <div class="absolute top-2 right-2">
              {item.id === protectedHistoryEntryId ? (
                <span class="rounded-md border border-amber-400/35 bg-amber-500/15 px-1.5 py-0.5 text-[10px] text-amber-200">
                  Current route
                </span>
              ) : (
                <form
                  method="POST"
                  action="/api/estimations/history/delete"
                  onsubmit="return confirm('Delete this saved estimation history entry?');"
                >
                  <input type="hidden" name="historyEntryId" value={item.id} />
                  <button
                    type="submit"
                    aria-label={`Delete saved estimation ${item.sourceFileName ?? "Saved route"} ${item.historyVersion}`}
                    class="rounded-md border border-rose-400/35 bg-rose-500/15 px-2 py-0.5 text-xs text-rose-100 transition-colors hover:bg-rose-500/30"
                  >
                    X
                  </button>
                </form>
              )}
            </div>
            <div class="mb-1 flex items-center justify-between gap-3 text-sm">
              <div class="flex items-center gap-2">
                <p class="font-medium text-white">{item.sourceFileName ?? "Saved route"}</p>
                {item.isLegacy ? (
                  <span class="rounded-md border border-amber-400/35 bg-amber-500/15 px-1.5 py-0.5 text-[10px] text-amber-200">
                    Legacy
                  </span>
                ) : (
                  <span class="rounded-md border border-blue-400/35 bg-blue-500/15 px-1.5 py-0.5 text-[10px] text-blue-200">
                    v{item.historyVersion}
                  </span>
                )}
              </div>
            </div>
            <div class="grid grid-cols-2 gap-2 text-sm text-blue-100/75">
              <p>
                <span class="text-blue-100/55">Estimated time:</span> {formatEstimatedTime(item.estimatedTimeMinutes)}
              </p>
              <p>
                <span class="text-blue-100/55">Difficulty:</span> {formatDifficultyLabel(item.difficulty)}
              </p>
              <p>
                <span class="text-blue-100/55">Distance:</span>{" "}
                {item.totalDistanceM !== null ? `${(item.totalDistanceM / 1000).toFixed(2)} km` : "n/a"}
              </p>
              <p>
                <span class="text-blue-100/55">Elevation gain:</span>{" "}
                {item.elevationGainM !== null ? `${item.elevationGainM.toFixed(0)} m` : "n/a"}
              </p>
              <p>
                <span class="text-blue-100/55">Avg pace:</span> {formatPace(item.averagePaceMinPerKm)}
              </p>
              <p>
                <span class="text-blue-100/55">ITRA Index:</span> {formatItraIndexInclusion(item.itraSignalStatus)}
              </p>
              <p>
                <span class="text-blue-100/55">Weather forecast:</span>{" "}
                {formatWeatherForecastInclusion(item.weatherSignalStatus)}
              </p>
            </div>
            <p class="mt-2 text-right text-xs text-blue-100/60">{formatComputedAt(item.computedAt)}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-blue-100/70">
        No saved estimations yet. Upload a route and keep your profile complete to populate history.
      </p>
    )
  }
</div>
